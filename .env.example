# Load with: node --env-file=.env server.mjs
PORT=3000
NODE_ENV=development
DATA_DIR=./runtime
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Production HTTPS deployment: NODE_ENV=production
# Fine-grained GitHub token: this repository only, Contents read/write
GITHUB_REPOSITORY=CarlosMElliot/Midterm-Test-2026-Oct
# Vercel backend: encrypted data branch, automatically created on first request
GITHUB_DATA_BRANCH=exam-data
GITHUB_DEFAULT_BRANCH=main
GITHUB_TOKEN=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a secure separate backup of this key; losing it prevents backup decryption.
RESULTS_ENCRYPTION_KEY=
RESEND_API_KEY=
MAIL_FROM=
